generator client {
    provider = "prisma-client"
    output   = "./client"
}

datasource db {
    provider = "mysql"
}

model User {
    id Int @id @default(autoincrement())

    name     String
    email    String @unique
    password String

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?
}
