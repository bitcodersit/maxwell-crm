generator client {
    provider = "prisma-client"
    output   = "./client"
}

datasource db {
    provider = "mysql"
}

model User {
    id Int @id @default(autoincrement())

    name            String
    email           String?   @unique
    phone           String?   @unique
    password        String?
    designation     String?
    organization    String?
    emailVerifiedAt DateTime?
    phoneVerifiedAt DateTime?

    addressableId Int?         @unique
    addressable   Addressable? @relation(fields: [addressableId], references: [id], onDelete: SetNull)

    avatarId Int?
    avatar   Attachment? @relation(fields: [avatarId], references: [id], onDelete: SetNull)

    userRoles UserRole[]

    creatorId Int?
    creator   User? @relation("UserCreator", fields: [creatorId], references: [id], onDelete: SetNull)

    createdUsers User[] @relation("UserCreator")

    teams               Team[]
    teamMembers         TeamMember[]
    teamMembersAssigned TeamMember[] @relation("TeamMemberAssigner")

    leads          Lead[] @relation("LeadCustomer")
    leadsAsCreator Lead[] @relation("LeadCreator")

    taskUsers      TaskUser[]
    taskItems      TaskItem[] @relation("TaskItemCompleter")
    tasksCreated   Task[]     @relation("TaskCreator")
    tasksReviewed  Task[]     @relation("TaskReviewer")
    tasksSubmitted Task[]     @relation("TaskSubmitter")

    bills         Bill[]         @relation("BillUser")
    billsAsAuthor Bill[]         @relation("BillAuthor")
    billApprovals BillApproval[] @relation("BillApprovalUser")

    assignableUsers           AssignableUser[] @relation("AssignableUser")
    assignableUsersAsAssigner AssignableUser[] @relation("AssignableUserAssigner")

    comments              Comment[]        @relation("CommentAuthor")
    auditLogs             AuditLog[]
    followUps             FollowUp[]       @relation("FollowUpAuthor")
    visitsAsAuthor        Visit[]          @relation("VisitAuthor")
    assignableTeams       AssignableTeam[] @relation("AssignableTeamAssigner")
    propertiesAsCreator   Property[]       @relation("PropertyCreator")
    attachmentsAsUploader Attachment[]     @relation("AttachmentUploader")

    notificationsAsActor      Notification[]          @relation("NotificationActor")
    notificationRecipients    NotificationRecipient[] @relation("NotificationRecipient")

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([email])
    @@index([creatorId])
    @@index([addressableId])
    @@map("users")
}

// END USER
// ================================================================
// START TEAM

enum TeamMemberRole {
    LEADER
    MEMBER
}

model Team {
    id Int @id @default(autoincrement())

    name        String  @unique
    description String? @db.Text

    avatarId  Int?
    creatorId Int?

    avatar    Attachment?  @relation(fields: [avatarId], references: [id], onDelete: SetNull)
    creator   User?        @relation(fields: [creatorId], references: [id], onDelete: SetNull)
    members   TeamMember[]
    taskTeams TaskTeam[]

    assignableTeams AssignableTeam[] @relation("AssignableTeam")

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([name])
    @@index([creatorId])
    @@map("teams")
}

model TeamMember {
    id Int @id @default(autoincrement())

    teamId     Int
    userId     Int
    assignerId Int?
    role       TeamMemberRole @default(MEMBER)

    team     Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
    user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
    assigner User? @relation("TeamMemberAssigner", fields: [assignerId], references: [id], onDelete: SetNull)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@unique([teamId, userId])
    @@index([teamId])
    @@index([userId])
    @@index([assignerId])
    @@map("team_members")
}

// END TEAM
// ================================================================
// START ROLE PERMISSION

model Role {
    id Int @id @default(autoincrement())

    name        String  @unique
    description String? @db.Text

    userRoles       UserRole[]
    rolePermissions RolePermission[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([name])
    @@map("roles")
}

model Permission {
    id Int @id @default(autoincrement())

    name        String  @unique
    description String? @db.Text

    rolePermissions RolePermission[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([name])
    @@map("permissions")
}

model UserRole {
    id Int @id @default(autoincrement())

    userId Int
    roleId Int

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

    @@unique([userId, roleId])
    @@index([userId])
    @@index([roleId])
    @@map("user_roles")
}

model RolePermission {
    id Int @id @default(autoincrement())

    roleId       Int
    permissionId Int

    role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
    permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

    @@unique([roleId, permissionId])
    @@index([roleId])
    @@index([permissionId])
    @@map("role_permissions")
}

// END ROLE PERMISSION
// ================================================================
// START ATTACHMENT
enum StorageProvider {
    FILESYSTEM
    S3
    SUPABASE
}

model Attachment {
    id Int @id @default(autoincrement())

    attachableId Int?
    attachable   Attachable? @relation(fields: [attachableId], references: [id], onDelete: SetNull)

    uploaderId Int?
    uploader   User? @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: SetNull)

    provider StorageProvider @default(FILESYSTEM)

    name String?
    path String
    type String?
    size Int?
    mime String?

    users User[]
    teams Team[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([attachableId])
    @@index([path])
    @@map("attachments")
}

model Attachable {
    id Int @id @default(autoincrement())

    task     Task?
    lead     Lead?
    visit    Visit?
    comment  Comment?
    followUp FollowUp?
    property Property?

    attachments Attachment[]

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    @@map("attachables")
}

// END ATTACHMENT
// ================================================================
// START COMMENT

model Commentable {
    id Int @id @default(autoincrement())

    lead     Lead?     @relation("LeadCommentable")
    followUp FollowUp? @relation("FollowUpCommentable")
    visit    Visit?    @relation("VisitCommentable")

    comments Comment[]

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    @@map("commentables")
}

model Comment {
    id Int @id @default(autoincrement())

    commentableId Int?
    commentable   Commentable? @relation(fields: [commentableId], references: [id], onDelete: SetNull)

    attachableId Int?        @unique
    attachable   Attachable? @relation(fields: [attachableId], references: [id], onDelete: SetNull)

    authorId Int?
    author   User? @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

    text String @db.Text

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([commentableId, createdAt])
    @@index([attachableId])
    @@index([authorId, createdAt])
    @@map("comments")
}

// END COMMENT
// ================================================================
// START BOARD

enum BoardModule {
    LEADS
    TASKS
}

model Board {
    id Int @id @default(autoincrement())

    name      String
    module    BoardModule
    isDefault Boolean     @default(false)

    items   BoardItem[]
    columns BoardColumn[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@unique([module, name])
    @@index([module])
    @@index([name])
    @@map("boards")
}

model BoardColumn {
    id Int @id @default(autoincrement())

    boardId Int
    board   Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

    name      String
    pinned    Boolean @default(false)
    isDefault Boolean @default(false)
    sortOrder String  @db.VarChar(255)
    color     String? @db.VarChar(32)

    items BoardItem[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@unique([boardId, name])
    @@index([boardId, sortOrder])
    @@map("board_columns")
}

model BoardItem {
    id Int @id @default(autoincrement())

    boardId  Int
    columnId Int

    sortOrder String @db.VarChar(255)

    leadId Int?
    lead   Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)

    taskId Int?
    task   Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

    board  Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
    column BoardColumn @relation(fields: [columnId], references: [id], onDelete: Restrict)

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    @@unique([boardId, leadId])
    @@unique([boardId, taskId])
    @@index([columnId, sortOrder])
    @@index([boardId, leadId])
    @@index([boardId, taskId])
    @@map("board_items")
}

// END BOARD
// ================================================================
// START TASK
enum TaskStatus {
    TODO
    IN_PROGRESS
    IN_REVIEW
    FAILED
    COMPLETED
    CANCELLED
}

enum TaskPriority {
    URGENT
    HIGH
    MEDIUM
    LOW
}

enum TaskItemStatus {
    TODO
    COMPLETED
}

enum TaskKind {
    TASK
    TARGET
}

enum TargetFrequency {
    WEEKLY
    MONTHLY
    CUSTOM
}

model Task {
    id Int @id @default(autoincrement())

    name        String  @db.Text
    description String? @db.Text

    kind     TaskKind     @default(TASK)
    status   TaskStatus   @default(TODO)
    priority TaskPriority @default(MEDIUM)

    creatorId    Int?
    reviewerId   Int?
    submitterId  Int?
    attachableId Int? @unique
    parentId     Int?

    dueAt       DateTime?
    reviewedAt  DateTime?
    submittedAt DateTime?

    creator    User?           @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
    reviewer   User?           @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
    submitter  User?           @relation("TaskSubmitter", fields: [submitterId], references: [id], onDelete: SetNull)
    parent     Task?           @relation("TaskOccurrences", fields: [parentId], references: [id], onDelete: Cascade)
    children   Task[]          @relation("TaskOccurrences")
    recurrence TaskRecurrence?

    items      TaskItem[]
    users      TaskUser[]
    teams      TaskTeam[]
    boardItems BoardItem[]
    attachable Attachable? @relation(fields: [attachableId], references: [id], onDelete: SetNull)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([status, priority])
    @@index([dueAt])
    @@index([kind, dueAt])
    @@index([parentId])
    @@index([creatorId])
    @@index([reviewerId])
    @@index([submitterId])
    @@index([attachableId])
    @@map("tasks")
}

model TaskRecurrence {
    id Int @id @default(autoincrement())

    taskId Int @unique

    frequency    TargetFrequency
    intervalDays Int?
    rangeStart   DateTime
    rangeEnd     DateTime
    endsAt       DateTime?
    nextRunAt    DateTime?

    task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([nextRunAt])
    @@index([frequency])
    @@map("task_recurrences")
}

model TaskItem {
    id Int @id @default(autoincrement())

    taskId    Int
    name      String @db.Text
    sortOrder Int    @default(0)

    status        TaskItemStatus @default(TODO)
    completedAt   DateTime?
    completedById Int?

    task        Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
    completedBy User? @relation("TaskItemCompleter", fields: [completedById], references: [id], onDelete: SetNull)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([taskId, sortOrder])
    @@index([taskId, status])
    @@index([completedById])
    @@map("task_items")
}

model TaskUser {
    id Int @id @default(autoincrement())

    taskId Int
    userId Int

    task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@unique([taskId, userId])
    @@index([taskId])
    @@index([userId])
    @@map("task_users")
}

model TaskTeam {
    id Int @id @default(autoincrement())

    taskId Int
    teamId Int

    task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
    team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@unique([taskId, teamId])
    @@index([taskId])
    @@index([teamId])
    @@map("task_teams")
}

// END TASK
// ================================================================
// START CRM

enum OptionType {
    SIZE
    SOURCE
    BILL_TYPE
    PROPERTY_TYPE_SUB
    PROPERTY_TYPE_MAIN
    PROPERTY_PURCHASE_TYPE
}

model Option {
    id Int @id @default(autoincrement())

    name String
    type OptionType

    billsAsType              Bill[]         @relation("BillTypeOption")
    leadsAsSource            Lead[]         @relation("LeadSourceOption")
    propertySizes            PropertySize[]
    leadsAsPropertyTypeSub   Lead[]         @relation("LeadPropertyTypeSubOption")
    leadsAsPropertyTypeMain  Lead[]         @relation("LeadPropertyTypeMainOption")
    propertiesAsPurchaseType Property[]     @relation("PropertyPurchaseTypeOption")

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@unique([name, type])
    @@index([type])
    @@index([name])
    @@map("options")
}

enum LeadStatus {
    New
    Hot
    Warm
    Cold
    Not_Interested
    Closed
}

enum FollowUpType {
    Call
    Visit
    Email
    Message
    Whatsapp
}

enum FollowUpStatus {
    Pending
    Completed
    Rescheduled
    Cancelled
    Failed
}

enum VisitStatus {
    Pending
    Completed
    Rescheduled
    Cancelled
    No_Show
}

enum BillStatus {
    New
    Pending
    Approved
    Cancelled
    Rejected
}

enum BillApprovalStage {
    Leader
    Accountant
    Admin
    Reject
}

model Lead {
    id  Int    @id @default(autoincrement())
    sid String @unique @db.VarChar(32)

    status LeadStatus @default(New)

    budgetMin Decimal? @db.Decimal(18, 2)
    budgetMax Decimal? @db.Decimal(18, 2)

    creatorId Int?
    creator   User? @relation("LeadCreator", fields: [creatorId], references: [id], onDelete: SetNull)

    assignableId Int?
    assignable   Assignable? @relation(fields: [assignableId], references: [id], onDelete: SetNull)

    addressId Int?
    address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

    sourceId Int?
    source   Option? @relation("LeadSourceOption", fields: [sourceId], references: [id], onDelete: SetNull)

    customerId Int?
    customer   User? @relation("LeadCustomer", fields: [customerId], references: [id], onDelete: SetNull)

    propertyTypeMainId Int?
    propertyTypeMain   Option? @relation("LeadPropertyTypeMainOption", fields: [propertyTypeMainId], references: [id], onDelete: SetNull)

    propertyTypeSubId Int?
    propertyTypeSub   Option? @relation("LeadPropertyTypeSubOption", fields: [propertyTypeSubId], references: [id], onDelete: SetNull)

    attachableId Int?        @unique
    attachable   Attachable? @relation(fields: [attachableId], references: [id], onDelete: SetNull)

    commentableId Int?         @unique
    commentable   Commentable? @relation("LeadCommentable", fields: [commentableId], references: [id], onDelete: SetNull)

    externalSource String? @db.VarChar(32)
    externalId     String? @db.VarChar(128)

    visits     Visit[]
    followUps  FollowUp[]
    boardItems BoardItem[]
    properties LeadProperty[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([customerId])
    @@index([creatorId])
    @@index([assignableId])
    @@index([addressId])
    @@index([sourceId])
    @@index([propertyTypeMainId])
    @@index([propertyTypeSubId])
    @@index([status])
    @@index([createdAt])
    @@index([attachableId])
    @@index([commentableId])
    @@unique([externalSource, externalId])
    @@map("leads")
}

model FollowUp {
    id Int @id @default(autoincrement())

    leadId Int
    lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

    authorId Int?
    author   User? @relation("FollowUpAuthor", fields: [authorId], references: [id], onDelete: SetNull)

    date   DateTime
    type   FollowUpType
    status FollowUpStatus @default(Pending)

    outcome  String?   @db.Text
    nextDate DateTime?

    attachableId Int?        @unique
    attachable   Attachable? @relation(fields: [attachableId], references: [id], onDelete: SetNull)

    commentableId Int?         @unique
    commentable   Commentable? @relation("FollowUpCommentable", fields: [commentableId], references: [id], onDelete: SetNull)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([leadId, date])
    @@index([type])
    @@index([status])
    @@index([nextDate])
    @@index([attachableId])
    @@index([commentableId])
    @@map("follow_ups")
}

model Visit {
    id Int @id @default(autoincrement())

    date   DateTime
    status VisitStatus @default(Pending)

    checkIn          Json?
    nextAction       String? @db.Text
    customerPresence String? @db.Text

    authorId Int?
    author   User? @relation("VisitAuthor", fields: [authorId], references: [id], onDelete: SetNull)

    leadId Int?
    lead   Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

    propertyId Int?
    property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

    attachableId Int?        @unique
    attachable   Attachable? @relation(fields: [attachableId], references: [id], onDelete: SetNull)

    commentableId Int?         @unique
    commentable   Commentable? @relation("VisitCommentable", fields: [commentableId], references: [id], onDelete: SetNull)

    assignableId Int?
    assignable   Assignable? @relation(fields: [assignableId], references: [id], onDelete: SetNull)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([leadId, date])
    @@index([propertyId, date])
    @@index([status])
    @@index([attachableId])
    @@index([assignableId])
    @@index([commentableId])
    @@index([authorId])
    @@map("visits")
}

model Bill {
    id Int @id @default(autoincrement())

    userId Int
    user   User @relation("BillUser", fields: [userId], references: [id], onDelete: Cascade)

    authorId Int?
    author   User? @relation("BillAuthor", fields: [authorId], references: [id], onDelete: SetNull)

    typeId Int
    type   Option @relation("BillTypeOption", fields: [typeId], references: [id], onDelete: Restrict)

    date    DateTime
    amount  Decimal    @db.Decimal(18, 2)
    status  BillStatus @default(New)
    purpose String?    @db.Text

    reviewedAt DateTime?

    approvals BillApproval[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([userId, date])
    @@index([authorId, date])
    @@index([typeId])
    @@index([status])
    @@map("bills")
}

model BillApproval {
    id Int @id @default(autoincrement())

    billId Int
    userId Int
    stage  BillApprovalStage

    bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)
    user User @relation("BillApprovalUser", fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    @@index([billId])
    @@index([userId])
    @@index([stage])
    @@map("bill_approvals")
}

enum PropertyStatus {
    Available
    Hold
    Sold
}

model Property {
    id  Int    @id @default(autoincrement())
    sid String @unique @db.VarChar(32)

    name   String
    status PropertyStatus @default(Available)

    creatorId Int?
    creator   User? @relation("PropertyCreator", fields: [creatorId], references: [id], onDelete: SetNull)

    assignableId Int?
    assignable   Assignable? @relation(fields: [assignableId], references: [id], onDelete: SetNull)

    addressId Int?
    address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

    purchaseTypeId Int?
    purchaseType   Option? @relation("PropertyPurchaseTypeOption", fields: [purchaseTypeId], references: [id], onDelete: SetNull)

    attachableId Int?        @unique
    attachable   Attachable? @relation(fields: [attachableId], references: [id], onDelete: SetNull)

    facing        String?
    price         Decimal? @db.Decimal(18, 2)
    previousPrice Decimal? @db.Decimal(18, 2)

    visits Visit[]
    sizes  PropertySize[]
    leads  LeadProperty[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([status])
    @@index([creatorId])
    @@index([assignableId])
    @@index([addressId])
    @@index([attachableId])
    @@map("properties")
}

model PropertySize {
    id Int @id @default(autoincrement())

    propertyId Int
    property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

    size      Option?  @relation(fields: [sizeId], references: [id], onDelete: SetNull)
    sizeId    Int?
    sizeValue Decimal? @db.Decimal(12, 2)

    @@map("property_sizes")
}

model LeadProperty {
    id Int @id @default(autoincrement())

    leadId     Int
    propertyId Int

    lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
    property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    @@unique([leadId, propertyId])
    @@index([leadId])
    @@index([propertyId])
    @@map("lead_properties")
}

model Address {
    id Int @id @default(autoincrement())

    name          String?
    addressLine1  String
    road          String?
    block         String?
    addressableId Int?

    leads       Lead[]
    properties  Property[]
    addressable Addressable? @relation(fields: [addressableId], references: [id], onDelete: SetNull)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@unique([addressLine1, road, block])
    @@index([addressLine1])
    @@index([name])
    @@index([road])
    @@index([block])
    @@index([addressableId])
    @@map("addresses")
}

model Addressable {
    id Int @id @default(autoincrement())

    user      User?
    addresses Address[]

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    @@map("addressables")
}

model Assignable {
    id Int @id @default(autoincrement())

    leads      Lead[]
    visits     Visit[]
    properties Property[]

    users AssignableUser[]
    teams AssignableTeam[]

    @@map("assignables")
}

model AssignableUser {
    id Int @id @default(autoincrement())

    assignableId Int
    assignable   Assignable @relation(fields: [assignableId], references: [id], onDelete: Cascade)

    userId Int
    user   User @relation("AssignableUser", fields: [userId], references: [id], onDelete: Cascade)

    assignerId Int?
    assigner   User? @relation("AssignableUserAssigner", fields: [assignerId], references: [id], onDelete: SetNull)

    @@unique([assignableId, userId])
    @@index([assignableId])
    @@index([userId])
    @@index([assignerId])
    @@map("assignable_users")
}

model AssignableTeam {
    id Int @id @default(autoincrement())

    assignableId Int
    assignable   Assignable @relation(fields: [assignableId], references: [id], onDelete: Cascade)

    teamId Int
    team   Team @relation("AssignableTeam", fields: [teamId], references: [id], onDelete: Cascade)

    assignerId Int?
    assigner   User? @relation("AssignableTeamAssigner", fields: [assignerId], references: [id], onDelete: SetNull)

    @@unique([assignableId, teamId])
    @@index([assignableId])
    @@index([teamId])
    @@index([assignerId])
    @@map("assignable_teams")
}

// END CRM
// ================================================================
// START UTILITY

enum TokenType {
    VERIFY
    RESET
    OTP
}

enum TokenModelType {
    USER
}

enum EmailStatus {
    PENDING
    PROCESSING
    SENT
    FAILED
    SKIPPED
}

enum EmailPriority {
    NORMAL
    URGENT
}

enum EmailFrequency {
    ONCE
    DAILY
    WEEKLY
    MONTHLY
}

model Token {
    id Int @id @default(autoincrement())

    modelId   Int
    modelType TokenModelType
    type      TokenType
    token     String         @unique

    expiresAt DateTime?
    usedAt    DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    @@index([modelId, modelType, type])
    @@index([type])
    @@index([expiresAt])
    @@map("tokens")
}

model EmailJob {
    id Int @id @default(autoincrement())

    to      Json
    cc      Json?
    bcc     Json?
    subject String
    html    String @db.Text

    status    EmailStatus    @default(PENDING)
    priority  EmailPriority  @default(NORMAL)
    frequency EmailFrequency @default(ONCE)
    action    Json?

    attempts    Int       @default(0)
    maxAttempts Int       @default(3)
    message     String?   @db.Text
    failedAt    DateTime?
    scheduledAt DateTime  @default(now())
    sentAt      DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    @@index([status, scheduledAt])
    @@index([priority, status, scheduledAt])
    @@map("email_jobs")
}

model AuditLog {
    id            Int      @id @default(autoincrement())
    userId        Int?
    recordId      Json
    action        String
    model         String
    oldData       Json?
    newData       Json?
    changedFields Json?
    ipAddress     String?
    userAgent     String?
    metadata      Json?
    createdAt     DateTime @default(now())
    user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

    @@index([model, createdAt])
    @@index([userId, createdAt])
    @@map("audit_logs")
}

// END UTILITY
// ================================================================
// START NOTIFICATION

enum NotificationType {
    LEAD_CREATED
    LEAD_ASSIGNED
    LEAD_STATUS_CHANGED
    PROPERTY_CREATED
    PROPERTY_ASSIGNED
    FOLLOW_UP_REMINDER
    VISIT_REMINDER
    BILL_STATUS_CHANGED
    ADMIN_BROADCAST
}

enum NotificationSubjectType {
    LEAD
    PROPERTY
    FOLLOW_UP
    VISIT
    BILL
    USER
}

model Notification {
    id Int @id @default(autoincrement())

    type  NotificationType
    title String
    body  String @db.Text

    actorId Int?
    actor   User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

    subjectType NotificationSubjectType?
    subjectId   Int?

    data Json?

    recipients NotificationRecipient[]

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    @@index([type, createdAt])
    @@index([subjectType, subjectId])
    @@index([actorId])
    @@map("notifications")
}

model NotificationRecipient {
    id Int @id @default(autoincrement())

    notificationId Int
    notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

    userId Int
    user   User @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

    readAt    DateTime?
    seenAt    DateTime?
    deletedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    @@unique([notificationId, userId])
    @@index([userId, readAt, createdAt])
    @@index([userId, deletedAt, createdAt])
    @@map("notification_recipients")
}

// END NOTIFICATION
// ================================================================
