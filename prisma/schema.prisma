generator client {
    provider = "prisma-client"
    output   = "./client"
}

datasource db {
    provider = "mysql"
}

model User {
    id Int @id @default(autoincrement())

    name            String
    email           String?   @unique
    phone           String?   @unique
    password        String?
    avatarId        Int?
    creatorId       Int?
    emailVerifiedAt DateTime?
    phoneVerifiedAt DateTime?

    teams               Team[]
    avatar              Attachment?  @relation(fields: [avatarId], references: [id], onDelete: SetNull)
    creator             User?        @relation("UserCreator", fields: [creatorId], references: [id], onDelete: SetNull)
    users               User[]       @relation("UserCreator")
    userRoles           UserRole[]
    teamMembers         TeamMember[]
    teamMembersAssigned TeamMember[] @relation("TeamMemberAssigner")

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([email])
    @@index([creatorId])
    @@map("users")
}

enum TokenType {
    VERIFY
    RESET
    OTP
}

enum TokenModelType {
    USER
}

enum EmailStatus {
    PENDING
    PROCESSING
    SENT
    FAILED
    SKIPPED
}

enum EmailPriority {
    NORMAL
    URGENT
}

enum EmailFrequency {
    ONCE
    DAILY
    WEEKLY
    MONTHLY
}

model Token {
    id Int @id @default(autoincrement())

    modelId   Int
    modelType TokenModelType
    type      TokenType
    token     String         @unique

    expiresAt DateTime?
    usedAt    DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    @@index([modelId, modelType, type])
    @@index([type])
    @@index([expiresAt])
    @@map("tokens")
}

model EmailJob {
    id Int @id @default(autoincrement())

    to      Json
    cc      Json?
    bcc     Json?
    subject String
    html    String @db.Text

    status    EmailStatus    @default(PENDING)
    priority  EmailPriority  @default(NORMAL)
    frequency EmailFrequency @default(ONCE)
    action    Json?

    attempts    Int       @default(0)
    maxAttempts Int       @default(3)
    message     String?   @db.Text
    failedAt    DateTime?
    scheduledAt DateTime  @default(now())
    sentAt      DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    @@index([status, scheduledAt])
    @@index([priority, status, scheduledAt])
    @@map("email_jobs")
}

model Team {
    id Int @id @default(autoincrement())

    name        String  @unique
    description String? @db.Text

    avatarId  Int?
    creatorId Int?

    avatar  Attachment?  @relation(fields: [avatarId], references: [id], onDelete: SetNull)
    creator User?        @relation(fields: [creatorId], references: [id], onDelete: SetNull)
    members TeamMember[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([name])
    @@index([creatorId])
    @@map("teams")
}

enum TeamMemberRole {
    LEADER
    MEMBER
}

model TeamMember {
    id Int @id @default(autoincrement())

    teamId     Int
    userId     Int
    assignerId Int?
    role       TeamMemberRole @default(MEMBER)

    team     Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
    user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
    assigner User? @relation("TeamMemberAssigner", fields: [assignerId], references: [id], onDelete: SetNull)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@unique([teamId, userId])
    @@index([teamId])
    @@index([userId])
    @@index([assignerId])
    @@map("team_members")
}

model Role {
    id Int @id @default(autoincrement())

    name        String  @unique
    description String? @db.Text

    userRoles       UserRole[]
    rolePermissions RolePermission[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([name])
    @@map("roles")
}

model Permission {
    id Int @id @default(autoincrement())

    name        String  @unique
    description String? @db.Text

    rolePermissions RolePermission[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([name])
    @@map("permissions")
}

model UserRole {
    id Int @id @default(autoincrement())

    userId Int
    roleId Int

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

    @@unique([userId, roleId])
    @@index([userId])
    @@index([roleId])
    @@map("user_roles")
}

model RolePermission {
    id Int @id @default(autoincrement())

    roleId       Int
    permissionId Int

    role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
    permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

    @@unique([roleId, permissionId])
    @@index([roleId])
    @@index([permissionId])
    @@map("role_permissions")
}

enum StorageProvider {
    FILESYSTEM
    S3
    SUPABASE
}

model Attachment {
    id Int @id @default(autoincrement())

    provider StorageProvider @default(FILESYSTEM)

    name String?
    path String
    type String?
    size Int?
    mime String?

    users User[]
    teams Team[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([path])
    @@map("attachments")
}
