generator client {
    provider = "prisma-client"
    output   = "./client"
}

datasource db {
    provider = "mysql"
}

model User {
    id Int @id @default(autoincrement())

    name            String
    email           String?   @unique
    phone           String?   @unique
    password        String?
    avatarId        Int?
    creatorId       Int?
    emailVerifiedAt DateTime?
    phoneVerifiedAt DateTime?

    avatar    Attachment? @relation(fields: [avatarId], references: [id], onDelete: SetNull)
    userRoles UserRole[]

    creator      User?  @relation("UserCreator", fields: [creatorId], references: [id], onDelete: SetNull)
    createdUsers User[] @relation("UserCreator")

    teams               Team[]
    teamMembers         TeamMember[]
    teamMembersAssigned TeamMember[] @relation("TeamMemberAssigner")

    leads          Lead[] @relation("LeadCustomer")
    leadsAsCreator Lead[] @relation("LeadCreator")

    taskUsers      TaskUser[]
    taskItems      TaskItem[] @relation("TaskItemCompleter")
    tasksCreated   Task[]     @relation("TaskCreator")
    tasksReviewed  Task[]     @relation("TaskReviewer")
    tasksSubmitted Task[]     @relation("TaskSubmitter")

    assignableUsers           AssignableUser[] @relation("AssignableUser")
    assignableUsersAsAssigner AssignableUser[] @relation("AssignableUserAssigner")

    assignableTeams     AssignableTeam[] @relation("AssignableTeamAssigner")
    propertiesAsCreator Property[]       @relation("PropertyCreator")

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([email])
    @@index([creatorId])
    @@map("users")
}

// END USER
// ================================================================
// START TEAM

enum TeamMemberRole {
    LEADER
    MEMBER
}

model Team {
    id Int @id @default(autoincrement())

    name        String  @unique
    description String? @db.Text

    avatarId  Int?
    creatorId Int?

    avatar    Attachment?  @relation(fields: [avatarId], references: [id], onDelete: SetNull)
    creator   User?        @relation(fields: [creatorId], references: [id], onDelete: SetNull)
    members   TeamMember[]
    taskTeams TaskTeam[]

    assignableTeams AssignableTeam[] @relation("AssignableTeam")

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([name])
    @@index([creatorId])
    @@map("teams")
}

model TeamMember {
    id Int @id @default(autoincrement())

    teamId     Int
    userId     Int
    assignerId Int?
    role       TeamMemberRole @default(MEMBER)

    team     Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
    user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
    assigner User? @relation("TeamMemberAssigner", fields: [assignerId], references: [id], onDelete: SetNull)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@unique([teamId, userId])
    @@index([teamId])
    @@index([userId])
    @@index([assignerId])
    @@map("team_members")
}

// END TEAM
// ================================================================
// START ROLE PERMISSION

model Role {
    id Int @id @default(autoincrement())

    name        String  @unique
    description String? @db.Text

    userRoles       UserRole[]
    rolePermissions RolePermission[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([name])
    @@map("roles")
}

model Permission {
    id Int @id @default(autoincrement())

    name        String  @unique
    description String? @db.Text

    rolePermissions RolePermission[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([name])
    @@map("permissions")
}

model UserRole {
    id Int @id @default(autoincrement())

    userId Int
    roleId Int

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

    @@unique([userId, roleId])
    @@index([userId])
    @@index([roleId])
    @@map("user_roles")
}

model RolePermission {
    id Int @id @default(autoincrement())

    roleId       Int
    permissionId Int

    role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
    permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

    @@unique([roleId, permissionId])
    @@index([roleId])
    @@index([permissionId])
    @@map("role_permissions")
}

// END ROLE PERMISSION
// ================================================================
// START ATTACHMENT
enum StorageProvider {
    FILESYSTEM
    S3
    SUPABASE
}

model Attachment {
    id Int @id @default(autoincrement())

    provider StorageProvider @default(FILESYSTEM)

    name String?
    path String
    type String?
    size Int?
    mime String?

    users       User[]
    teams       Team[]
    attachables Attachable[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([path])
    @@map("attachments")
}

// Morph like, as prisma doesn't support polymorphic relations natively
// we will use this table to store the relationship between attachments and other models as needed
model Attachable {
    id Int @id @default(autoincrement())

    attachmentId Int
    attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

    taskId Int?
    task   Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

    leadId Int?
    lead   Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)

    propertyId Int?
    property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    @@unique([attachmentId, taskId])
    @@unique([attachmentId, leadId])
    @@unique([attachmentId, propertyId])
    @@index([taskId])
    @@index([leadId])
    @@index([propertyId])
    @@map("attachables")
}

// END ATTACHMENT
// ================================================================
// START BOARD

model Board {
    id Int @id @default(autoincrement())

    name String @unique

    items   BoardItem[]
    columns BoardColumn[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@map("boards")
}

model BoardColumn {
    id Int @id @default(autoincrement())

    boardId Int
    name    String
    color   String? @db.VarChar(32)

    sortOrder String  @db.VarChar(255)
    pinned    Boolean @default(false)

    board Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
    items BoardItem[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@unique([boardId, name])
    @@index([boardId, sortOrder])
    @@map("board_columns")
}

// Morph-like, as prisma doesn't support polymorphic relations natively
// we will use nullable module ids to attach board cards with their entities
model BoardItem {
    id Int @id @default(autoincrement())

    boardId  Int
    columnId Int

    sortOrder String @db.VarChar(255)

    leadId Int?
    taskId Int?

    board  Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
    column BoardColumn @relation(fields: [columnId], references: [id], onDelete: Restrict)
    lead   Lead?       @relation(fields: [leadId], references: [id], onDelete: Cascade)
    task   Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    @@unique([boardId, leadId])
    @@unique([boardId, taskId])
    @@index([columnId, sortOrder])
    @@index([boardId, leadId])
    @@index([boardId, taskId])
    @@map("board_items")
}

// END BOARD
// ================================================================
// START TASK
enum TaskStatus {
    TODO
    IN_PROGRESS
    IN_REVIEW
    FAILED
    COMPLETED
    CANCELLED
}

enum TaskPriority {
    URGENT
    HIGH
    MEDIUM
    LOW
}

enum TaskItemStatus {
    TODO
    COMPLETED
}

model Task {
    id Int @id @default(autoincrement())

    name        String  @db.Text
    description String? @db.Text

    status   TaskStatus   @default(TODO)
    priority TaskPriority @default(MEDIUM)

    creatorId   Int?
    reviewerId  Int?
    submitterId Int?

    dueAt       DateTime?
    reviewedAt  DateTime?
    submittedAt DateTime?

    creator   User? @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
    reviewer  User? @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
    submitter User? @relation("TaskSubmitter", fields: [submitterId], references: [id], onDelete: SetNull)

    items       TaskItem[]
    users       TaskUser[]
    teams       TaskTeam[]
    boardItems  BoardItem[]
    attachables Attachable[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([status, priority])
    @@index([dueAt])
    @@index([creatorId])
    @@index([reviewerId])
    @@index([submitterId])
    @@map("tasks")
}

model TaskItem {
    id Int @id @default(autoincrement())

    taskId    Int
    name      String @db.Text
    sortOrder Int    @default(0)

    status        TaskItemStatus @default(TODO)
    completedAt   DateTime?
    completedById Int?

    task        Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
    completedBy User? @relation("TaskItemCompleter", fields: [completedById], references: [id], onDelete: SetNull)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([taskId, sortOrder])
    @@index([taskId, status])
    @@index([completedById])
    @@map("task_items")
}

model TaskUser {
    id Int @id @default(autoincrement())

    taskId Int
    userId Int

    task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@unique([taskId, userId])
    @@index([taskId])
    @@index([userId])
    @@map("task_users")
}

model TaskTeam {
    id Int @id @default(autoincrement())

    taskId Int
    teamId Int

    task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
    team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@unique([taskId, teamId])
    @@index([taskId])
    @@index([teamId])
    @@map("task_teams")
}

// END TASK
// ================================================================
// START CRM

enum OptionType {
    SOURCE
    PROPERTY_TYPE_MAIN
    PROPERTY_TYPE_SUB
    SIZE
}

model Option {
    id Int @id @default(autoincrement())

    name String
    type OptionType

    leadsAsSource           Lead[]         @relation("LeadSourceOption")
    leadsAsPropertyTypeMain Lead[]         @relation("LeadPropertyTypeMainOption")
    leadsAsPropertyTypeSub  Lead[]         @relation("LeadPropertyTypeSubOption")
    propertySizes           PropertySize[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@unique([name, type])
    @@index([type])
    @@index([name])
    @@map("options")
}

enum LeadStatus {
    New
    Hot
    Warm
    Cold
    Not_Interested
    Closed
}

model Lead {
    id  Int    @id @default(autoincrement())
    sid String @unique @db.VarChar(32)

    status LeadStatus @default(New)

    budgetMin Decimal? @db.Decimal(18, 2)
    budgetMax Decimal? @db.Decimal(18, 2)

    creatorId Int?
    creator   User? @relation("LeadCreator", fields: [creatorId], references: [id], onDelete: SetNull)

    assignableId Int?
    assignable   Assignable? @relation(fields: [assignableId], references: [id], onDelete: SetNull)

    addressId Int?
    address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

    sourceId Int?
    source   Option? @relation("LeadSourceOption", fields: [sourceId], references: [id], onDelete: SetNull)

    customerId Int?
    customer   User? @relation("LeadCustomer", fields: [customerId], references: [id], onDelete: SetNull)

    propertyTypeMainId Int?
    propertyTypeMain   Option? @relation("LeadPropertyTypeMainOption", fields: [propertyTypeMainId], references: [id], onDelete: SetNull)

    propertyTypeSubId Int?
    propertyTypeSub   Option? @relation("LeadPropertyTypeSubOption", fields: [propertyTypeSubId], references: [id], onDelete: SetNull)

    properties  LeadProperty[]
    boardItems  BoardItem[]
    attachables Attachable[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([customerId])
    @@index([creatorId])
    @@index([assignableId])
    @@index([addressId])
    @@index([sourceId])
    @@index([propertyTypeMainId])
    @@index([propertyTypeSubId])
    @@index([status])
    @@index([createdAt])
    @@map("leads")
}

enum PropertyStatus {
    Available
    Hold
    Sold
}

model Property {
    id  Int    @id @default(autoincrement())
    sid String @unique @db.VarChar(32)

    name   String
    status PropertyStatus @default(Available)

    creatorId Int?
    creator   User? @relation("PropertyCreator", fields: [creatorId], references: [id], onDelete: SetNull)

    assignableId Int?
    assignable   Assignable? @relation(fields: [assignableId], references: [id], onDelete: SetNull)

    addressId Int?
    address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

    facing        String?
    price         Decimal? @db.Decimal(18, 2)
    previousPrice Decimal? @db.Decimal(18, 2)

    sizes       PropertySize[]
    leads       LeadProperty[]
    attachables Attachable[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([status])
    @@index([creatorId])
    @@index([assignableId])
    @@index([addressId])
    @@map("properties")
}

model PropertySize {
    id Int @id @default(autoincrement())

    propertyId Int
    property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

    size      Option?  @relation(fields: [sizeId], references: [id], onDelete: SetNull)
    sizeId    Int?
    sizeValue Decimal? @db.Decimal(12, 2)

    @@map("property_sizes")
}

model LeadProperty {
    id Int @id @default(autoincrement())

    leadId     Int
    propertyId Int

    lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
    property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    @@unique([leadId, propertyId])
    @@index([leadId])
    @@index([propertyId])
    @@map("lead_properties")
}

model Address {
    id Int @id @default(autoincrement())

    name         String?
    addressLine1 String
    road         String?
    block        String?

    leads      Lead[]
    properties Property[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    @@index([addressLine1])
    @@index([name])
    @@index([road])
    @@index([block])
    @@map("addresses")
}

model Assignable {
    id Int @id @default(autoincrement())

    leads      Lead[]
    properties Property[]

    assignedUsers AssignableUser[]
    assignedTeams AssignableTeam[]

    @@map("assignables")
}

model AssignableUser {
    id Int @id @default(autoincrement())

    assignableId Int
    assignable   Assignable @relation(fields: [assignableId], references: [id], onDelete: Cascade)

    userId Int
    user   User @relation("AssignableUser", fields: [userId], references: [id], onDelete: Cascade)

    assignerId Int?
    assigner   User? @relation("AssignableUserAssigner", fields: [assignerId], references: [id], onDelete: SetNull)

    @@unique([assignableId, userId])
    @@index([assignableId])
    @@index([userId])
    @@index([assignerId])
    @@map("assignable_users")
}

model AssignableTeam {
    id Int @id @default(autoincrement())

    assignableId Int
    assignable   Assignable @relation(fields: [assignableId], references: [id], onDelete: Cascade)

    teamId Int
    team   Team @relation("AssignableTeam", fields: [teamId], references: [id], onDelete: Cascade)

    assignerId Int?
    assigner   User? @relation("AssignableTeamAssigner", fields: [assignerId], references: [id], onDelete: SetNull)

    @@unique([assignableId, teamId])
    @@index([assignableId])
    @@index([teamId])
    @@index([assignerId])
    @@map("assignable_teams")
}

// END CRM
// ================================================================
// START UTILITY

enum TokenType {
    VERIFY
    RESET
    OTP
}

enum TokenModelType {
    USER
}

enum EmailStatus {
    PENDING
    PROCESSING
    SENT
    FAILED
    SKIPPED
}

enum EmailPriority {
    NORMAL
    URGENT
}

enum EmailFrequency {
    ONCE
    DAILY
    WEEKLY
    MONTHLY
}

model Token {
    id Int @id @default(autoincrement())

    modelId   Int
    modelType TokenModelType
    type      TokenType
    token     String         @unique

    expiresAt DateTime?
    usedAt    DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    @@index([modelId, modelType, type])
    @@index([type])
    @@index([expiresAt])
    @@map("tokens")
}

model EmailJob {
    id Int @id @default(autoincrement())

    to      Json
    cc      Json?
    bcc     Json?
    subject String
    html    String @db.Text

    status    EmailStatus    @default(PENDING)
    priority  EmailPriority  @default(NORMAL)
    frequency EmailFrequency @default(ONCE)
    action    Json?

    attempts    Int       @default(0)
    maxAttempts Int       @default(3)
    message     String?   @db.Text
    failedAt    DateTime?
    scheduledAt DateTime  @default(now())
    sentAt      DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    @@index([status, scheduledAt])
    @@index([priority, status, scheduledAt])
    @@map("email_jobs")
}

// END UTILITY
// ================================================================
